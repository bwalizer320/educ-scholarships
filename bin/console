#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Database\AdminSeeder;
use App\Database\BaseSeeder;
use App\Database\Connection;
use App\Database\Fy27ScholarshipSeeder;
use App\Database\Migrator;
use App\Database\TestSeeder;
use App\Mail\MailProviderFactory;
use App\Services\Notifications\MailJobWorker;
use App\Storage\LocalFileStorage;
use App\Support\Doctor;
use App\Support\Env;

$root = require dirname(__DIR__) . '/app/bootstrap.php';

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'migrate':
        $migrator = new Migrator(Connection::get(), $root . '/database/migrations');
        $ran = $migrator->migrate();

        if ($ran === []) {
            fwrite(STDOUT, "No pending migrations.\n");
            exit(0);
        }

        foreach ($ran as $migration) {
            fwrite(STDOUT, "Applied {$migration}\n");
        }
        break;

    case 'seed:base':
        $seeder = new BaseSeeder(Connection::get(), $root . '/database/seeds/program_data.tsv');
        $result = $seeder->run();

        fwrite(
            STDOUT,
            sprintf(
                "Seeded %d departments, %d programs, and %d official program offerings.\n",
                $result['departments'],
                $result['programs'],
                $result['offerings']
            )
        );
        break;

    case 'seed:admin':
        $name = Env::get('BOOTSTRAP_ADMIN_NAME', '') ?? '';
        $email = Env::get('BOOTSTRAP_ADMIN_EMAIL', '') ?? '';
        $password = Env::get('BOOTSTRAP_ADMIN_PASSWORD', '') ?? '';
        $hawkid = Env::get('BOOTSTRAP_ADMIN_HAWKID');

        $seeder = new AdminSeeder(Connection::get());
        $userId = $seeder->createOrUpdate($name, $email, $password, $hawkid ?: null);
        fwrite(STDOUT, "Bootstrap system administrator ready (user ID {$userId}).\n");
        break;

    case 'seed:test':
        $seeder = new TestSeeder(Connection::get());
        $result = $seeder->run();
        fwrite(
            STDOUT,
            sprintf(
                "Loaded fake test data for cycle %d: %d scholarships, %d students. Reviewer: %s / %s. Recipient: %s / %s\n",
                $result['cycle_id'],
                $result['scholarships'],
                $result['students'],
                $result['coordinator_email'],
                $result['test_password'],
                $result['recipient_email'],
                $result['test_password']
            )
        );
        break;

    case 'seed:fy27':
        $workbookPath = $argv[2] ?? (Env::get('FY27_SCHOLARSHIP_WORKBOOK', '') ?? '');
        if ($workbookPath === '') {
            fwrite(STDERR, "Usage: php bin/console seed:fy27 \"/path/to/FY27 Scholarship Amounts.xlsx\"\n");
            fwrite(STDERR, "Or set FY27_SCHOLARSHIP_WORKBOOK in the environment.\n");
            exit(2);
        }

        $seeder = new Fy27ScholarshipSeeder(Connection::get(), new LocalFileStorage());
        $result = $seeder->run($workbookPath);

        fwrite(
            STDOUT,
            sprintf(
                "Loaded FY27 scholarship test data into %s: %d award rows, %d cycle scholarships, %d catalog scholarships, $%s authorized, %d source rows preserved, %d warning(s).\n",
                $result['cycle_label'],
                $result['authority_rows'],
                $result['cycle_scholarships'],
                $result['catalog_scholarships'],
                number_format((float)$result['cycle_authority_total'], 2),
                $result['source_rows'],
                $result['warnings']
            )
        );
        break;

    case 'doctor':
        $checks = Doctor::run($root);
        $failed = 0;
        foreach ($checks as $name => $check) {
            $ok = (bool) $check['ok'];
            fwrite(STDOUT, sprintf("[%s] %-24s %s\n", $ok ? 'OK' : 'FAIL', $name, $check['detail']));
            if (!$ok) {
                $failed++;
            }
        }
        exit($failed > 0 ? 1 : 0);

    case 'jobs:work':
        $worker = new MailJobWorker(
            Connection::get(),
            MailProviderFactory::make(),
            new LocalFileStorage()
        );
        $processed = 0;
        while ($processed < 25 && $worker->workOne()) {
            $processed++;
        }
        fwrite(STDOUT, "Processed {$processed} queued mail job(s).\n");
        break;

    case 'help':
    default:
        fwrite(STDOUT, "Scholarship Manager console\n\n");
        fwrite(STDOUT, "Commands:\n");
        fwrite(STDOUT, "  migrate     Apply pending SQL migrations\n");
        fwrite(STDOUT, "  seed:base   Seed College departments and official graduate program offerings\n");
        fwrite(STDOUT, "  seed:admin  Create/update the local bootstrap system administrator from .env\n");
        fwrite(STDOUT, "  seed:test   Load fake scholarship/reviewer/applicant data (non-production only)\n");
        fwrite(STDOUT, "  seed:fy27   Load the FY27 scholarship workbook as non-production test data\n");
        fwrite(STDOUT, "  jobs:work   Process up to 25 queued notification email jobs\n");
        fwrite(STDOUT, "  doctor      Check PHP extensions, database, storage, and production settings\n");
        break;
}
